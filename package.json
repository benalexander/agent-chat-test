{
  "name": "agent-chat-test",
  "private": true,
  "workspaces": [
    "app",
    "worker",
    "shared",
    "admin"
  ],
  "scripts": {
    "app": "npm run start -w app",
    "ios": "npm run ios -w app",
    "worker:dev": "npm run dev -w worker",
    "admin:dev": "npm run dev -w admin",
    "admin:build": "npm run build -w admin",
    "worker:deploy": "npm run build -w admin && npm run deploy -w worker",
    "test": "npm test -w worker && npm test -w app",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261109.1": true
  },
  "overrides": {
    "@babel/core": "^7.29.0"
  }
}
