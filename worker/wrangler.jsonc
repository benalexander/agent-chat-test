{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "agent-chat-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  // Logs (structured console.log events, see src/obs.ts) + traces (AI SDK spans via
  // wrapAISDK and custom coach.* spans); both under Workers → Observability / Agents.
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "durable_objects": {
    "bindings": [
      { "name": "CoachAgent", "class_name": "CoachAgent" },
      // Singleton (idFromName("global")) listing users for the admin panel.
      { "name": "Registry", "class_name": "Registry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CoachAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["Registry"] }
  ],
  // Admin UI (Vite build of ../admin, base "/admin/", hash routing) served at /admin/.
  // /api/* and /admin/api/* always hit the Worker; anything else that matches no asset
  // (e.g. "/", "/health") falls through to the Worker too.
  "assets": {
    "directory": "../admin/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/admin/api/*"]
  },
  "vars": {
    // Anthropic model id. e.g. "claude-haiku-5-5" for cheaper runs.
    "MODEL": "claude-sonnet-5-5",
    // "true" compresses proactive intervals to minutes (see src/config.ts).
    "DEV_MODE": "false",
    // "anthropic" | "mock" (mock = canned AI SDK mock model, no API key needed).
    "LLM_MODE": "anthropic",
    // Cloudflare AI Gateway. Leave empty to call Anthropic directly.
    "AI_GATEWAY_ACCOUNT_ID": "1d44a120701bc88e030fe966d799a60d",
    "AI_GATEWAY_ID": "agent-chat-test"
  }
  // Secrets (wrangler secret put / .dev.vars):
  //   ANTHROPIC_API_KEY, APP_SHARED_SECRET, ADMIN_SECRET, CF_AIG_TOKEN (optional)
}
