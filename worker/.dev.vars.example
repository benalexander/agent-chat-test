# Copy to .dev.vars for `wrangler dev`. Never commit .dev.vars.
APP_SHARED_SECRET=dev-secret
# "mock" works without an API key; set to "anthropic" + ANTHROPIC_API_KEY for real calls.
LLM_MODE=mock
ANTHROPIC_API_KEY=
# Optional: only if your AI Gateway is authenticated.
CF_AIG_TOKEN=
# Compress proactive intervals (check-in every 3 min, inactivity after 2 min, cooldown 30 s).
DEV_MODE=true
# Bearer token for the admin panel (/admin) and /admin/api/*. Distinct from APP_SHARED_SECRET.
ADMIN_SECRET=dev-admin
# Optional: Expo access token, required once enhanced push security is on for the Expo account.
EXPO_ACCESS_TOKEN=
