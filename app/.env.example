# Copy to .env.local (gitignored) and adjust. EXPO_PUBLIC_* values are inlined
# into the JS bundle at build time, so restart Metro (`npx expo start --clear`) after changing them.

# Worker base URL. Simulator + `wrangler dev`: http://localhost:8787
# Physical device: your deployed https://<name>.<account>.workers.dev
EXPO_PUBLIC_API_URL=http://localhost:8787

# Must match the worker's APP_SHARED_SECRET (.dev.vars locally, `wrangler secret put` when deployed).
EXPO_PUBLIC_APP_SECRET=dev-secret
